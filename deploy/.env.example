# ============================================================
# csBaby 部署环境变量模板（不包含真实凭据）
# 复制为 .env 后填入真实值，.env 已被 .gitignore 排除
# ============================================================

# ----- 通用 -----
GUNICORN_WORKERS=2

# ----- API 服务（api.aiagent0.com） -----
# 数据库（云托管 PostgreSQL）
DB_HOST=__FILL_DB_HOST__
DB_PORT=5432
DB_NAME=__FILL_DB_NAME__
DB_USER=__FILL_DB_USER__
DB_PASSWORD=__FILL_DB_PASSWORD__

# JWT
JWT_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
JWT_ALGORITHM=HS256

# ----- Sync 服务（sync.aiagent0.com） -----
# 共用同一个 PostgreSQL 实例
DB_HOST=__FILL_DB_HOST__
DB_PORT=5432
DB_NAME=__FILL_DB_NAME__
DB_USER=__FILL_DB_USER__
DB_PASSWORD=__FILL_DB_PASSWORD__
JWT_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# ----- Admin 服务（admin.agentai0.com） -----
# Admin 上游 API 地址（admin 容器访问 API 的入口）
API_BASE_URL=https://api.agentai0.com
# Admin session 密钥
SESSION_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
# 初始管理员（首次启动时如不存在则自动创建）
ADMIN_NAME=__FILL_ADMIN_NAME__
ADMIN_PHONE=__FILL_ADMIN_PHONE__
ADMIN_PASSWORD=__FILL_ADMIN_PASSWORD__
