org.gradle.jvmargs=-Xmx4096m -Xms1024m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8
# org.gradle.java.home=D:/jdk19  # 本地开发用，CI 使用默认 JDK
android.useAndroidX=true
android.enableJetifier=true
kotlin.code.style=official
android.nonTransitiveRClass=true

# 应用版本配置
APP_VERSION_CODE=8
APP_VERSION_NAME=1.2.0
