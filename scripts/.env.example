# csBaby 后端环境变量模板
# 复制为 .env 并填入真实值

# ===== Flask =====
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-string
DATABASE_PATH=csBaby.db

# ===== Auth =====
JWT_SECRET=change-me-to-another-random-string
JWT_EXPIRES_HOURS=24

# ===== AI Providers (可选) =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== Supabase (双写同步) =====
# 已有：项目 URL
SUPABASE_URL=https://xxx.supabase.co

# 新增：Postgres 直连 URL（使用 transaction pooler 端口 6543）
# 格式: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# ===== Sync Worker (双写同步) =====
# 重试 worker 间隔（秒）
SYNC_RETRY_INTERVAL_SECONDS=30
# 最大重试次数（超过入死信表）
SYNC_MAX_ATTEMPTS=10
# Supabase 写入超时（秒）
SYNC_SUPABASE_TIMEOUT_SECONDS=5

# ===== 部署平台 secrets =====
# 这些不进 .env，由 Render/Docker 平台配置
# SHZAL_PASSWORD=...
