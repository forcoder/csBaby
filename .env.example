# csBaby API 环境变量示例文件 (占位符,真实凭据写到 .env)
# 安全规则: 不要把真实凭据提交到 Git,.env 必须加入 .gitignore

# ===== Supabase PostgreSQL (Phase 0 权威,Phase 1+ 备份目标) =====
# 格式: postgresql://user:pass@host:port/db
SUPABASE_PGSQL_URL=postgresql://USER:PASS@HOST:5432/postgres

# ===== Aliyun RDS MySQL (Phase 1+ 主写候选) =====
# 格式: mysql://user:pass@host:3306/db
# 留空 = 关闭 RDS 双写,仅写 Supabase
# 配置后 = API 自动启用 Supabase + RDS 双写
RDS_DB_URL=

# ===== 本地 API 配置 =====
PORT=8080
DATABASE_PATH=/data/csbaby.db
SERVICE_NAME=csbaby-api

# ===== Sync Retry Worker =====
SYNC_RETRY_INTERVAL_SECONDS=30

# ===== Android 签名配置 (示例,真实密码在 .env) =====
SIGNING_STORE_PASSWORD=change-me
SIGNING_KEY_PASSWORD=change-me
SIGNING_KEY_ALIAS=csbaby-release

# ===== 第三方服务 (示例) =====
RENDER_API_KEY=change-me
SHZAL_PASSWORD=change-me