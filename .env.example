# csBaby API 环境变量示例文件 (占位符,真实凭据写到 .env)
# 安全规则: 不要把真实凭据提交到 Git,.env 必须加入 .gitignore

# ===== Aliyun RDS MySQL ⭐ Phase 2 主写 (同步服务端 + API 双端) =====
# 格式: mysql://user:pass@host:3306/db?charset=utf8mb4
# Phase 2 起 csBaby-server-py 也连此库;SUPABASE 仅作周期备份
DB_URL=mysql://USER:PASS@HOST:3306/r2346qiaozhou?charset=utf8mb4

# ===== Supabase PostgreSQL (Phase 2 仅作备份源,不再主写) =====
# 格式: postgresql://user:pass@host:port/db
SUPABASE_PGSQL_URL=postgresql://USER:PASS@HOST:5432/postgres

# ===== 兼容旧 PG 配置 (Phase 1 过渡,可逐步废弃) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=csbaby

# ===== API 本地配置 =====
RDS_DB_URL=mysql://USER:PASS@HOST:3306/r2346qiaozhou
PORT=8080
DATABASE_PATH=/data/csbaby.db
SERVICE_NAME=csbaby-api

# ===== Sync Retry Worker =====
SYNC_RETRY_INTERVAL_SECONDS=30

# ===== Android 签名配置 (示例,真实密码在 .env) =====
SIGNING_STORE_PASSWORD=change-me
SIGNING_KEY_PASSWORD=change-me
SIGNING_KEY_ALIAS=csbaby-release

# ===== 第三方服务 (示例) =====
RENDER_API_KEY=change-me
SHZAL_PASSWORD=change-me